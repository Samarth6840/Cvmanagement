@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }

    @if (!_editorReady)
    {
        <textarea class="form-control font-monospace" rows="@Rows"
                  placeholder="@Placeholder" value="@Value"
                  @oninput="OnFallbackInputAsync"></textarea>
    }

    <div id="@_hostId" class="markdown-editor-host"></div>
</div>

@code {
    private static int _nextHostId;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 8;

    private readonly string _hostId = $"mde-host-{Interlocked.Increment(ref _nextHostId)}";
    private IJSObjectReference? _module;
    private bool _editorReady;
    private string _current = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _current = Value ?? string.Empty;

        var module = await GetModuleAsync();
        _editorReady = await module.InvokeAsync<bool>("init", _hostId, _current, DotNetObjectReference.Create(this));
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_editorReady || Value == _current)
            return;

        _current = Value ?? string.Empty;
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("setValue", _hostId, _current);
    }

    [JSInvokable]
    public async Task OnEditorChanged(string value)
    {
        _current = value;
        await ValueChanged.InvokeAsync(value);
    }

    private Task OnFallbackInputAsync(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/markdown-editor.js");

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("destroy", _hostId);
        }
        catch (JSDisconnectedException)
        {
        }

        if (_module is not null)
            await _module.DisposeAsync();
    }
}
