@page "/cvs/{Id}"
@using CvManagement.Services.Cv
@using CvManagement.Services.Auth
@using CvManagement.Services.Markdown
@using CvManagement.Data.Entities.Attributes
@using CvManagement.Data.Entities.Cv
@using CvManagement.Data.Entities.Positions
@attribute [Authorize]
@inject ICvService CvService
@inject ICurrentUserService CurrentUserService
@inject IMarkdownRenderer MarkdownRenderer
@inject NavigationManager Navigation

@if (_forbidden)
{
    <h3>@Loc["Cv.NotAvailable"]</h3>
    <p class="text-muted">@Loc["Cv.NoAccessToThis"]</p>
    <a href="/cvs" class="btn btn-secondary">@Loc["Cv.BackToCvs"]</a>
}
else if (_cv is null)
{
    <p>@Loc["Common.Loading"]</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3>@_cv.Title</h3>
            <p class="text-muted">Position: <a href="/positions/@_cv.PositionId">@_cv.Position?.Title</a></p>
            <p class="text-muted">Candidate: @_cv.CandidateProfile?.User?.DisplayName</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge @(_cv.Status == CvStatus.Published ? "bg-success" : "bg-warning") fs-6">@_cv.Status</span>
            <LikeButton CvRecordId="_cv.Id" />
            @if (_canEdit)
            {
                <a href="/cvs/@_cv.Id/edit" class="btn btn-primary btn-sm">@Loc["Common.Edit"]</a>
            }
        </div>
    </div>

    @if (_rules.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">@Loc["Cv.Attributes"]</h5></div>
            <div class="card-body">
                @foreach (var rule in _rules)
                {
                    var def = rule.AttributeDefinition!;
                    var value = GetValue(def.Id);
                    var unfilled = !CvService.IsValueFilled(value);
                    <div class="mb-2">
                        <strong>@def.Name@(rule.IsRequired ? " *" : ""):</strong>
                        @if (unfilled)
                        {
                            <span class="text-danger fw-bold">@Loc["Cv.Empty"]</span>
                        }
                        else if (def.DataType == AttributeDataType.Text && !string.IsNullOrEmpty(value?.TextValue))
                        {
                            <MarkdownPreview Markdown="@value.TextValue" />
                        }
                        else if (def.DataType == AttributeDataType.Image && !string.IsNullOrEmpty(value?.ImageUrl))
                        {
                            <img src="@value.ImageUrl" class="img-thumbnail" style="max-height: 100px;" />
                        }
                        else
                        {
                            <span>@GetValueDisplay(value)</span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_projects.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">@Loc["Cv.Projects"]</h5></div>
            <div class="card-body">
                @foreach (var proj in _projects)
                {
                    <div class="mb-3">
                        <h6>@proj.Name</h6>
                        <small class="text-muted">@(proj.StartDate?.ToString("MMM yyyy")) - @(proj.EndDate?.ToString("MMM yyyy") ?? "Present")</small>
                        @if (!string.IsNullOrEmpty(proj.Description))
                        {
                            <MarkdownPreview Markdown="@proj.Description" />
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private CvRecord? _cv;
    private bool _forbidden;
    private bool _canEdit;
    private List<PositionAttributeRule> _rules = new();
    private Dictionary<Guid, ProfileAttributeValue> _values = new();
    private List<Project> _projects = new();

    protected override async Task OnInitializedAsync()
    {
        var cvId = Guid.Parse(Id);

        // Recruiters get read-only access; candidates only their own CVs (spec §3.5/§3.6).
        if (!await CvService.CanReadAsync(cvId))
        {
            _forbidden = true;
            return;
        }

        _cv = await CvService.GetByIdAsync(cvId);
        if (_cv is null) return;

        _canEdit = await CvService.CanEditAsync(cvId);
        _rules = await CvService.GetCvAttributeRulesAsync(cvId);
        _values = await CvService.GetCvAttributeValueMapAsync(cvId);
        _projects = await CvService.GetCvProjectsAsync(cvId);
    }

    private ProfileAttributeValue? GetValue(Guid id) => _values.GetValueOrDefault(id);

    private string GetValueDisplay(ProfileAttributeValue? v)
    {
        if (v?.AttributeDefinition is null) return "";
        return v.AttributeDefinition.DataType switch
        {
            AttributeDataType.String => v.StringValue ?? "",
            AttributeDataType.Numeric => v.NumericValue?.ToString() ?? "",
            AttributeDataType.Date => v.DateValue?.ToString("MMM dd, yyyy") ?? "",
            AttributeDataType.Period => $"{v.PeriodStart?.ToString("MMM yyyy")} - {v.PeriodEnd?.ToString("MMM yyyy") ?? "Present"}",
            AttributeDataType.OneOfMany => v.SelectedOption?.Label ?? "",
            AttributeDataType.Boolean => v.BoolValue == true ? "Yes" : "No",
            _ => ""
        };
    }
}
