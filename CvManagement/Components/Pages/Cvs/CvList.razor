@page "/cvs"
@using CvManagement.Services.Cv
@using CvManagement.Services.Auth
@using CvManagement.Services.Profiles
@using CvManagement.Data.Entities.Cv
@attribute [Authorize]
@inject ICvService CvService
@inject ICurrentUserService CurrentUserService
@inject IProfileService ProfileService
@rendermode InteractiveServer

<h3>@Loc["Cv.ListTitle"]</h3>

@if (_isCandidate)
{
    <div class="mb-3">
        <a href="/positions" class="btn btn-primary btn-sm">@Loc["Cv.CreateNew"]</a>
    </div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Loc["Common.Title"]</th>
            <th>@Loc["Nav.Positions"]</th>
            <th>@Loc["Common.Status"]</th>
            <th>@Loc["Position.Likes"]</th>
            <th>@Loc["Common.Created"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cv in _cvs)
        {
            <tr>
                <td><a href="/cvs/@cv.Id">@cv.Title</a></td>
                <td><a href="/positions/@cv.PositionId">@cv.Position?.Title</a></td>
                <td><span class="badge @(cv.Status == CvStatus.Published ? "bg-success" : "bg-warning")">@cv.Status</span></td>
                <td>@cv.LikeCount</td>
                <td>@cv.CreatedAt.ToString("MMM dd, yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (!_cvs.Any())
{
    <p class="text-muted">@Loc["Cv.NoCvs"]</p>
}

@code {
    private List<CvRecord> _cvs = new();
    private bool _isCandidate;

    protected override async Task OnInitializedAsync()
    {
        _isCandidate = await CurrentUserService.IsInRoleAsync(RoleNames.Candidate) || await CurrentUserService.IsInRoleAsync(RoleNames.Administrator);

        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null) return;

        var profile = await ProfileService.GetOrCreateProfileAsync(userId.Value);
        _cvs = await CvService.GetCandidateCvsAsync(profile.Id);
    }
}
