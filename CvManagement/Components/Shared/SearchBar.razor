@rendermode InteractiveServer

<div class="input-group input-group-sm">
    <input type="text" class="form-control" placeholder="Search positions, CVs..."
           @bind="_query" @bind:event="oninput" @onkeydown="HandleKeyDown" />
    <button class="btn btn-outline-secondary" @onclick="DoSearch">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
        </svg>
    </button>
</div>

@code {
    private string _query = "";

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            DoSearch();
    }

    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(_query))
        {
            NavigationManager.NavigateTo($"/search?q={Uri.EscapeDataString(_query)}");
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
