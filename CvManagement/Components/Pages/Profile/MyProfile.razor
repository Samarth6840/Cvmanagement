@page "/profile"
@using CvManagement.Services.Auth
@using CvManagement.Services.Profiles
@using CvManagement.Services.Concurrency
@using CvManagement.Services.Attributes
@using CvManagement.Services.Projects
@using CvManagement.Data.Entities.Profiles
@using CvManagement.Data.Entities.Attributes
@using CvManagement.Data.Entities.Projects
@attribute [Authorize]
@implements IAsyncDisposable
@inject ICurrentUserService CurrentUserService
@inject IProfileService ProfileService
@inject IAttributeService AttributeService
@inject IProjectService ProjectService
@rendermode InteractiveServer

<h3>@Loc["Profile.MyProfile"]</h3>

@if (_profile is null)
{
    <p>@Loc["Common.Loading"]</p>
}
else
{
    @if (_isSaving)
    {
        <div class="alert alert-info py-2">@Loc["Profile.Saving"]</div>
    }
    @if (_conflictMessage is not null)
    {
        <div class="alert alert-warning">
            @_conflictMessage
            <button class="btn btn-sm btn-warning ms-2" @onclick="Reload">@Loc["Profile.ReloadAndStartOver"]</button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0">@Loc["Profile.Me"]</h5></div>
        <div class="card-body">
            @foreach (var attr in _builtinAttributes)
            {
                var value = GetValue(attr.Id);
                <div class="mb-3">
                    <label class="form-label fw-bold">@attr.Name</label>
                    <AttributeValueEditor Attribute="attr" Options="attr.Options.ToList()"
                        StringValue="@(value?.StringValue)"
                        StringValueChanged="v => SetValue(attr.Id, val => val.StringValue = v)"
                        ImageUrl="@(value?.ImageUrl)"
                        ImageUrlChanged="v => SetValue(attr.Id, val => val.ImageUrl = v)"
                        NumericValue="@(value?.NumericValue)"
                        NumericValueChanged="v => SetValue(attr.Id, val => val.NumericValue = v)"
                        DateValue="@(value?.DateValue)"
                        DateValueChanged="v => SetValue(attr.Id, val => val.DateValue = v)"
                        BoolValue="@(value?.BoolValue)"
                        BoolValueChanged="v => SetValue(attr.Id, val => val.BoolValue = v)" />
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Loc["Profile.Info"]</h5>
            <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddAttributeModal">@Loc["Profile.AddAttribute"]</button>
        </div>
        <div class="card-body">
            @foreach (var attr in _infoAttributes)
            {
                var value = GetValue(attr.Id);
                <div class="mb-3">
                    <label class="form-label fw-bold">@attr.Name</label>
                    <AttributeValueEditor Attribute="attr" Options="attr.Options.ToList()"
                        StringValue="@(value?.StringValue)"
                        StringValueChanged="v => SetValue(attr.Id, val => val.StringValue = v)"
                        TextValue="@(value?.TextValue)"
                        TextValueChanged="v => SetValue(attr.Id, val => val.TextValue = v)"
                        ImageUrl="@(value?.ImageUrl)"
                        ImageUrlChanged="v => SetValue(attr.Id, val => val.ImageUrl = v)"
                        NumericValue="@(value?.NumericValue)"
                        NumericValueChanged="v => SetValue(attr.Id, val => val.NumericValue = v)"
                        DateValue="@(value?.DateValue)"
                        DateValueChanged="v => SetValue(attr.Id, val => val.DateValue = v)"
                        PeriodStart="@(value?.PeriodStart)"
                        PeriodStartChanged="v => SetValue(attr.Id, val => val.PeriodStart = v)"
                        PeriodEnd="@(value?.PeriodEnd)"
                        PeriodEndChanged="v => SetValue(attr.Id, val => val.PeriodEnd = v)"
                        BoolValue="@(value?.BoolValue)"
                        BoolValueChanged="v => SetValue(attr.Id, val => val.BoolValue = v)"
                        SelectedOptionId="@(value?.SelectedOptionId)"
                        SelectedOptionIdChanged="v => SetValue(attr.Id, val => val.SelectedOptionId = v)" />
                    <button class="btn btn-sm btn-outline-danger mt-1" @onclick="() => RemoveInfoAttribute(attr)">@Loc["Profile.Remove"]</button>
                </div>
            }
            @if (_infoAttributes.Count == 0)
            {
                <p class="text-muted">@Loc["Profile.NoInfoAttributes"]</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Loc["Profile.Projects"]</h5>
            <a href="/my/projects" class="btn btn-sm btn-outline-primary">@Loc["Profile.ManageProjects"]</a>
        </div>
        <div class="card-body">
            @if (_projects.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var project in _projects)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>@project.Name</span>
                            <span class="text-muted small">
                                @project.StartDate?.ToString("MMM yyyy") - @(project.EndDate?.ToString("MMM yyyy") ?? Loc["Common.Present"].Value)
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">@Loc["Profile.NoProjects"]</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@Loc["Nav.MyCvs"]</h5>
            <a href="/cvs" class="btn btn-sm btn-outline-primary">@Loc["Profile.OpenCvs"]</a>
        </div>
        <div class="card-body">
            <p class="text-muted mb-0">@Loc["Profile.CvsHint"]</p>
        </div>
    </div>

    @if (_showAddModal)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@Loc["Profile.AddAttributeTitle"]</h5>
                        <button type="button" class="btn-close" @onclick="() => _showAddModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" class="form-control mb-2" placeholder="@Loc["Profile.SearchAttributes"]" @bind="_attrSearchPrefix" @bind:event="oninput" />
                        @foreach (var attr in FilteredAvailableAttributes)
                        {
                            <button class="list-group-item list-group-item-action" @onclick="() => AddInfoAttribute(attr)">@attr.Name <small class="text-muted">(@attr.Category?.Name)</small></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private static readonly TimeSpan AutoSaveInterval = TimeSpan.FromSeconds(5);

    private CandidateProfile? _profile;
    private List<AttributeDefinition> _allAttributes = [];
    private List<AttributeDefinition> _builtinAttributes = [];
    private List<AttributeDefinition> _infoAttributes = [];
    private List<AttributeDefinition> _availableAttributes = [];
    private List<Project> _projects = [];
    private Dictionary<Guid, ProfileAttributeValue> _values = [];

    // The version this screen read. Sent back on every save; the server rejects the write
    // if the stored version has moved on (spec §4).
    private byte[] _version = [];
    private bool _isDirty;
    private bool _isSaving;
    private string? _conflictMessage;
    private bool _showAddModal;
    private string _attrSearchPrefix = string.Empty;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    private IEnumerable<AttributeDefinition> FilteredAvailableAttributes =>
        _availableAttributes
            .Where(a => a.Name.Contains(_attrSearchPrefix, StringComparison.OrdinalIgnoreCase))
            .Take(10);

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null) return;

        await LoadAsync(userId.Value);

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(AutoSaveInterval);
        _ = AutoSaveLoopAsync(_cts.Token);
    }

    private async Task LoadAsync(Guid userId)
    {
        _profile = await ProfileService.GetOrCreateProfileAsync(userId);
        _version = _profile.RowVersion;
        _values = _profile.AttributeValues.ToDictionary(v => v.AttributeDefinitionId);

        _allAttributes = (await AttributeService.GetAllAsync()).ToList();

        // Spec §5.1: the "Me" section is the built-in attributes. They live in the same
        // library and the same engine as every other attribute, are attachable to position
        // templates, and are protected from deletion on the server, not merely hidden here.
        _builtinAttributes = _allAttributes.Where(a => a.IsBuiltIn).ToList();
        _projects = await ProjectService.GetForCandidateAsync(_profile.Id);

        var filledAttributeIds = _values.Keys.ToHashSet();
        _infoAttributes = _allAttributes
            .Where(a => filledAttributeIds.Contains(a.Id) && !a.IsBuiltIn)
            .ToList();

        // Built-ins are always shown, so they are never offered as "addable" info attributes.
        _availableAttributes = _allAttributes
            .Where(a => !filledAttributeIds.Contains(a.Id) && !a.IsBuiltIn)
            .ToList();
        _isDirty = false;
        _conflictMessage = null;
    }

    private async Task AutoSaveLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
            {
                if (_isDirty)
                    await InvokeAsync(SaveIfDirtyAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task SaveIfDirtyAsync()
    {
        if (_profile is null) return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            _version = await ProfileService.SaveValuesAsync(_profile.Id, _values.Values.Select(ToInput).ToList(), _version);
            _isDirty = false;
            _conflictMessage = null;
        }
        catch (ConcurrencyConflictException ex)
        {
            _conflictMessage = ex.Message;
            _isDirty = false;
        }
        catch (InvalidOperationException ex)
        {
            _conflictMessage = ex.Message;
            _isDirty = false;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private static AttributeValueInput ToInput(ProfileAttributeValue value) =>
        new(value.AttributeDefinitionId,
            value.StringValue, value.TextValue, value.ImageUrl, value.NumericValue,
            value.DateValue, value.PeriodStart, value.PeriodEnd, value.BoolValue, value.SelectedOptionId);

    private ProfileAttributeValue? GetValue(Guid attributeId) =>
        _values.TryGetValue(attributeId, out var value) ? value : null;

    private void SetValue(Guid attributeId, Action<ProfileAttributeValue> mutate)
    {
        if (_profile is null) return;

        if (!_values.TryGetValue(attributeId, out var existing))
        {
            existing = new ProfileAttributeValue
            {
                CandidateProfileId = _profile.Id,
                AttributeDefinitionId = attributeId
            };
            _values[attributeId] = existing;
        }

        mutate(existing);
        _isDirty = true;
    }

    private void ShowAddAttributeModal() => _showAddModal = true;

    private void AddInfoAttribute(AttributeDefinition attr)
    {
        _infoAttributes.Add(attr);
        _availableAttributes.Remove(attr);
        _showAddModal = false;
    }

    private void RemoveInfoAttribute(AttributeDefinition attr)
    {
        _infoAttributes.Remove(attr);
        _availableAttributes.Add(attr);
        _values.Remove(attr.Id);
        _isDirty = true;
    }

    private async Task Reload()
    {
        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null) return;

        await LoadAsync(userId.Value);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
            await _cts.CancelAsync();

        _cts?.Dispose();
        _timer?.Dispose();
    }
}
