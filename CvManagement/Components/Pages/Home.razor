@page "/"
@using CvManagement.Services.Positions
@using CvManagement.Services.Auth
@inject IPositionService PositionService
@inject ICurrentUserService CurrentUser
@rendermode InteractiveServer

<PageTitle>@Loc["Home.Landing"]</PageTitle>

<h3 class="mb-4">@Loc["Home.Title"]</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card shadow-sm"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@_stats.Positions</div>
            <div class="text-muted small">@Loc["Home.Stat.Positions"]</div>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card shadow-sm"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@_stats.Candidates</div>
            <div class="text-muted small">@Loc["Home.Stat.Candidates"]</div>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card shadow-sm"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@_stats.Recruiters</div>
            <div class="text-muted small">@Loc["Home.Stat.Recruiters"]</div>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card shadow-sm"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@_stats.Cvs24h</div>
            <div class="text-muted small">@Loc["Home.Stat.NewCvs"]</div>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card shadow-sm"><div class="card-body text-center">
            <div class="fs-4 fw-bold">@_stats.TotalCvs</div>
            <div class="text-muted small">@Loc["Home.Stat.SubmittedCvs"]</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header">@Loc["Home.LatestPositions"]</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@Loc["Common.Title"]</th>
                            <th>@Loc["Common.Company"]</th>
                            <th>@Loc["Common.Status"]</th>
                            <th>@Loc["Home.CvColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in _latest)
                        {
                            <tr>
                                <td><a href="/positions/@pos.Id">@pos.Title</a></td>
                                <td>@pos.Company</td>
                                <td>
                                    <span class="badge @(pos.IsOpen ? "bg-success" : "bg-secondary")">@(pos.IsOpen ? Loc["Common.Open"] : Loc["Common.Closed"])</span>
                                    @if (!pos.IsPublic)
                                    {
                                        <span class="badge bg-warning text-dark">@Loc["Home.Restricted"]</span>
                                    }
                                </td>
                                <td>@pos.CvRecords.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">@Loc["Home.MostPopular"]</div>
            <div class="card-body p-0">
                @if (_popular.Any())
                {
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@Loc["Common.Title"]</th>
                                <th>@Loc["Common.Company"]</th>
                                <th>@Loc["Home.CvColumn"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _popular.Count; i++)
                            {
                                var pos = _popular[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><a href="/positions/@pos.Id">@pos.Title</a></td>
                                    <td>@pos.Company</td>
                                    <td>@pos.CvRecords.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted">@Loc["Home.NoCvs"]</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">@Loc["Home.Tags"]</div>
            <div class="card-body">
                <TagCloud Tags="_tags" LinksToCvs="_isRecruiter" />
                <div class="text-muted small mt-2">
                    @if (_isRecruiter)
                    {
                        <span>@Loc["Home.TagSearchRecruiter"]</span>
                    }
                    else
                    {
                        <span>@Loc["Home.TagSearchCandidate"]</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Position> _latest = new();
    private List<Position> _popular = new();
    private IReadOnlyList<(string Tag, int Count)> _tags = [];
    private (int Positions, int Candidates, int Recruiters, int Cvs24h, int TotalCvs) _stats;
    private bool _isRecruiter;

    protected override async Task OnInitializedAsync()
    {
        _isRecruiter = await CurrentUser.IsInRoleAsync(RoleNames.Recruiter) || await CurrentUser.IsInRoleAsync(RoleNames.Administrator);
        _latest = (await PositionService.GetLatestAsync(10))
            .Where(p => _isRecruiter || p.IsPublic)
            .ToList();
        _popular = (await PositionService.GetMostPopularAsync(5))
            .Where(p => _isRecruiter || p.IsPublic)
            .ToList();
        _tags = await PositionService.GetTagCountsAsync();
        _stats = await PositionService.GetLandingStatsAsync();
    }
}
