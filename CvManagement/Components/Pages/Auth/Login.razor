@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using CvManagement.Data.Entities.Identity
@inject SignInManager<ApplicationUser> SignInManager
@layout AuthLayout

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">Sign In</h3>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (QueryError is not null)
        {
            <div class="alert alert-danger">@QueryError</div>
        }

        <form @onsubmit="HandleLogin">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" @bind="Password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3">Sign In</button>
        </form>

        <div class="d-flex gap-2 mt-2">
            <a class="btn btn-outline-secondary w-100" href="/external-login/Google">Google</a>
            <a class="btn btn-outline-secondary w-100" href="/external-login/GitHub">GitHub</a>
        </div>

        <div class="text-center mt-3">
            <a href="/register">Create an account</a>
        </div>
    </div>
</div>

@code {
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    [SupplyParameterFromQuery] public string? error { get; set; }

    private string? ErrorMessage;

    private string? QueryError =>
        error switch
        {
            "provider-not-configured" => "Google/GitHub sign-in isn't configured yet.",
            "external-failed" => "External sign-in failed. Try again.",
            "no-email" => "Your account has no verified email.",
            "account-failed" => "Could not create your account.",
            "role-failed" => "Could not assign your role.",
            "link-failed" => "Could not link the provider to your account.",
            _ => null
        };

    private async Task HandleLogin()
    {
        var result = await SignInManager.PasswordSignInAsync(Email, Password, true, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
            ErrorMessage = "Invalid email or password.";
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}