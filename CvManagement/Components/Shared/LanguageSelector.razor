@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
            data-bs-toggle="dropdown" aria-expanded="false"
            title="@Loc["TopBar.Language"]" aria-label="@Loc["TopBar.Language"]">
        <span class="d-md-none">@Loc["TopBar.Language"]</span>
        <span class="d-none d-md-inline">@CurrentCultureCode</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var language in SupportedLanguages.All)
        {
            <li>
                <form method="post" action="/culture/set">
                    <AntiforgeryToken />
                    <input type="hidden" name="culture" value="@language.Code" />
                    <input type="hidden" name="redirectUri" value="@RedirectUri" />
                    <button type="submit"
                            class="dropdown-item @(language.Code == CurrentCultureCode ? "active" : "")">
                        @language.NativeName
                    </button>
                </form>
            </li>
        }
    </ul>
</div>

@code {
    private string CurrentCultureCode => SupportedLanguages.Normalize(
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);

    private string RedirectUri => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith('/')
        ? Navigation.ToBaseRelativePath(Navigation.Uri)
        : "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
}
