@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using CvManagement.Data.Entities.Identity
@inject SignInManager<ApplicationUser> SignInManager
@layout AuthLayout

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">@Loc["Auth.SignIn"]</h3>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        @if (QueryError is not null)
        {
            <div class="alert alert-danger">@QueryError</div>
        }

        <form @onsubmit="HandleLogin">
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.Email"]</label>
                <input type="email" class="form-control" @bind="Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.Password"]</label>
                <input type="password" class="form-control" @bind="Password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3">@Loc["Auth.SignIn"]</button>
        </form>

        <div class="d-flex gap-2 mt-2">
            <a class="btn btn-outline-secondary w-100" href="@ExternalLoginUrl("Google")">@Loc["Auth.Google"]</a>
            <a class="btn btn-outline-secondary w-100" href="@ExternalLoginUrl("GitHub")">@Loc["Auth.GitHub"]</a>
        </div>

        <div class="text-center mt-3">
            <a href="/register">@Loc["Auth.CreateAccount"]</a>
        </div>
    </div>
</div>

@code {
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    [SupplyParameterFromQuery] public string? error { get; set; }
    [SupplyParameterFromQuery] public string? returnUrl { get; set; }

    // Where to go after a successful sign-in. Only a path inside this app is honoured: an
    // absolute URL here would turn the login page into an open redirect.
    private string RedirectTarget =>
        !string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith('/') && !returnUrl.StartsWith("//")
            ? returnUrl
            : "/";

    private string? ErrorMessage;

    private string? QueryError =>
        error switch
        {
            "provider-not-configured" => Loc["Auth.ExternalProviderNotConfigured"].Value,
            "external-failed" => Loc["Auth.ExternalFailed"].Value,
            "no-email" => Loc["Auth.NoEmail"].Value,
            "account-failed" => Loc["Auth.AccountCreateFailed"].Value,
            "role-failed" => Loc["Auth.RoleAssignFailed"].Value,
            "link-failed" => Loc["Auth.LinkFailed"].Value,
            _ => null
        };

    private async Task HandleLogin()
    {
        // lockoutOnFailure keeps an administrator's block effective: a blocked account is
        // refused here rather than only being hidden in the admin table.
        var result = await SignInManager.PasswordSignInAsync(Email, Password, true, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(RedirectTarget, forceLoad: true);
            return;
        }

        ErrorMessage = result.IsLockedOut
            ? Loc["Auth.AccountBlocked"].Value
            : Loc["Auth.InvalidCredentials"].Value;
    }

    // Carries the return target through the OAuth round trip so a social sign-in also lands
    // back where the redirect sent the visitor.
    private string ExternalLoginUrl(string provider) =>
        RedirectTarget == "/"
            ? $"/external-login/{provider}"
            : $"/external-login/{provider}?returnUrl={Uri.EscapeDataString(RedirectTarget)}";

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}