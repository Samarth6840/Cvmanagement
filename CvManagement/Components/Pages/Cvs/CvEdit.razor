@page "/cvs/{Id}/edit"
@using CvManagement.Services.Cv
@using CvManagement.Data.Entities.Cv
@using CvManagement.Data.Entities.Attributes
@using CvManagement.Data.Entities.Positions
@using CvManagement.Data.Entities.Profiles
@attribute [Authorize]
@inject ICvService CvService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (_forbidden)
{
    <h3>@Loc["Cv.NotAvailable"]</h3>
    <p class="text-muted">@Loc["Cv.NoAccessToThis"]</p>
    <a href="/cvs" class="btn btn-secondary">@Loc["Cv.BackToCvs"]</a>
}
else if (_cv is null)
{
    <p>@Loc["Common.Loading"]</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@Loc["Cv.EditTitleWithName", _cv.Title]</h3>
        <div class="d-flex gap-2 align-items-center">
            @if (_cv.Status == CvStatus.Published)
            {
                <button class="btn btn-warning btn-sm" @onclick="Unpublish">@Loc["Cv.Unpublish"]</button>
            }
            <button class="btn btn-danger btn-sm" @onclick="Delete">@Loc["Cv.Delete"]</button>
        </div>
    </div>

    <p class="text-muted small">
        @Loc["Cv.ValuesNote"]
    </p>

    <div class="mb-3">
        <label class="form-label">@Loc["Cv.CvTitle"]</label>
        <input type="text" class="form-control" @bind="_cv.Title" @onfocusout="SaveTitle" />
    </div>

    @if (!string.IsNullOrEmpty(_saveMessage))
    {
        <div class="alert alert-success py-2">@_saveMessage</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }
    @if (_missing.Count > 0)
    {
        <div class="alert alert-warning">
            @Loc["Cv.PublishLocked", string.Join(", ", _missing.Select(m => m.AttributeDefinition!.Name))]
        </div>
    }

    @if (_rules.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["Cv.Attributes"]</h5>
                <button class="btn btn-primary btn-sm" @onclick="SaveValues">@Loc["Cv.SaveAttributes"]</button>
            </div>
            <div class="card-body">
                @foreach (var rule in _rules)
                {
                    var def = rule.AttributeDefinition!;
                    var value = GetValue(def.Id, def);
                    var unfilled = rule.IsRequired && !CvService.IsValueFilled(value);
                    <div class="mb-3">
                        <label class="form-label @(unfilled ? "text-danger fw-bold" : "")">
                            @def.Name @(rule.IsRequired ? "*" : "")
                        </label>
                        @if (unfilled)
                        {
                            <span class="text-danger">@Loc["Cv.Required"]</span>
                        }
                        <AttributeValueEditor Attribute="def"
                                              Options="def.Options"
                                              StringValue="value.StringValue"
                                              StringValueChanged="v => ValueChanged(def.Id, x => x.StringValue = v)"
                                              TextValue="value.TextValue"
                                              TextValueChanged="v => ValueChanged(def.Id, x => x.TextValue = v)"
                                              ImageUrl="value.ImageUrl"
                                              ImageUrlChanged="v => ValueChanged(def.Id, x => x.ImageUrl = v)"
                                              NumericValue="value.NumericValue"
                                              NumericValueChanged="v => ValueChanged(def.Id, x => x.NumericValue = v)"
                                              DateValue="value.DateValue"
                                              DateValueChanged="v => ValueChanged(def.Id, x => x.DateValue = v)"
                                              PeriodStart="value.PeriodStart"
                                              PeriodStartChanged="v => ValueChanged(def.Id, x => x.PeriodStart = v)"
                                              PeriodEnd="value.PeriodEnd"
                                              PeriodEndChanged="v => ValueChanged(def.Id, x => x.PeriodEnd = v)"
                                              BoolValue="value.BoolValue"
                                              BoolValueChanged="v => ValueChanged(def.Id, x => x.BoolValue = v)"
                                              SelectedOptionId="value.SelectedOptionId"
                                              SelectedOptionIdChanged="v => ValueChanged(def.Id, x => x.SelectedOptionId = v)" />
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        @if (_cv.Status == CvStatus.Draft)
        {
            <button class="btn btn-success" @onclick="Publish" disabled="@(_missing.Count > 0)">@Loc["Cv.Publish"]</button>
        }
        <a href="/cvs/@_cv.Id" class="btn btn-secondary">@Loc["Cv.BackToCv"]</a>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private CvRecord? _cv;
    private bool _forbidden;
    private List<PositionAttributeRule> _rules = new();
    private Dictionary<Guid, ProfileAttributeValue> _values = new();
    private List<PositionAttributeRule> _missing = new();
    private string? _saveMessage;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!await CvService.CanEditAsync(Guid.Parse(Id)))
        {
            _forbidden = true;
            return;
        }

        _cv = await CvService.GetByIdAsync(Guid.Parse(Id));
        if (_cv is null) return;

        _rules = await CvService.GetCvAttributeRulesAsync(_cv.Id);
        _values = await CvService.GetCvAttributeValueMapAsync(_cv.Id);
        await RefreshMissingAsync();
    }

    private async Task RefreshMissingAsync()
    {
        if (_cv is not null)
            _missing = await CvService.GetMissingRequiredRulesAsync(_cv.Id);
    }

    private ProfileAttributeValue GetValue(Guid id, AttributeDefinition def) =>
        _values.TryGetValue(id, out var existing)
            ? existing
            : _values[id] = new ProfileAttributeValue { AttributeDefinitionId = id, AttributeDefinition = def };

    private void ValueChanged(Guid id, Action<ProfileAttributeValue> mutate)
    {
        if (_values.TryGetValue(id, out var value))
            mutate(value);
        _saveMessage = null;
        _error = null;
    }

    private async Task SaveValues()
    {
        if (_cv is null) return;
        _saveMessage = null;
        _error = null;

        try
        {
            // One transaction for the whole form: the previous per-attribute loop could
            // commit N-1 values and silently drop the rest on the first failure.
            await CvService.SaveAttributeValuesAsync(_cv.Id, _values.Values);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }

        await RefreshMissingAsync();
        _saveMessage = Loc["Cv.AttributesSaved"];
    }

    private async Task SaveTitle()
    {
        if (_cv is null) return;
        try
        {
            await CvService.UpdateTitleAsync(_cv.Id, _cv.Title);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Publish()
    {
        if (_cv is null) return;
        try
        {
            await CvService.PublishAsync(_cv.Id);
            Navigation.NavigateTo($"/cvs/{_cv.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            await RefreshMissingAsync();
        }
    }

    private async Task Unpublish()
    {
        if (_cv is null) return;
        await CvService.UnpublishAsync(_cv.Id);
        Navigation.NavigateTo($"/cvs/{_cv.Id}");
    }

    private async Task Delete()
    {
        if (_cv is null) return;
        await CvService.DeleteAsync(_cv.Id);
        Navigation.NavigateTo("/cvs");
    }
}