@page "/positions/{Id}"
@using CvManagement.Services.Positions
@using CvManagement.Services.Auth
@using CvManagement.Services.Cv
@using CvManagement.Services.Profiles
@using CvManagement.Services.Markdown
@using CvManagement.Components.Pages.Discussions
@inject IPositionService PositionService
@inject ICurrentUserService CurrentUserService
@inject ICvService CvService
@inject IProfileService ProfileService
@inject IMarkdownRenderer MarkdownRenderer
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (_position is null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3>@_position.Title</h3>
            @if (!string.IsNullOrEmpty(_position.Company))
            {
                <span class="text-muted">@_position.Company</span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="text-danger">@_error</span>
            }
            <span class="badge @(_position.IsOpen ? "bg-success" : "bg-secondary") fs-6">
                @(_position.IsOpen ? "Open" : "Closed")
            </span>
            @if (_isRecruiter)
            {
                <a href="/positions/edit/@_position.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Duplicate">Duplicate</button>
            }
            @if (_isCandidate && _position.IsOpen)
            {
                @if (_canAccess)
                {
                    <a href="/cvs/create/@_position.Id" class="btn btn-primary btn-sm">Create CV</a>
                }
                else
                {
                    <span class="btn btn-primary btn-sm disabled" title="Your profile does not match this position's access rules">Create CV</span>
                }
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_position.Description))
    {
        <div class="card mb-4">
            <div class="card-body">
                <MarkdownPreview Markdown="@_position.Description" />
            </div>
        </div>
    }

    @if (_position.AttributeRules.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Required Attributes</h5></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var rule in _position.AttributeRules.OrderBy(r => r.SortOrder))
                    {
                        <span class="badge @(rule.IsRequired ? "bg-primary" : "bg-secondary")">
                            @rule.AttributeDefinition.Name
                            @if (rule.IsRequired) { <span class="ms-1">*</span> }
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    @if (_position.Tags.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Project Tags</h5></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tag in _position.Tags)
                    {
                        <span class="badge bg-info">@tag.Tag</span>
                    }
                </div>
                <p class="text-muted mt-2 mb-0">Max projects to include: @_position.MaxProjects</p>
            </div>
        </div>
    }

    @if (_visibleCvs.Any())
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Submitted CVs (@_visibleCvs.Count)</h5></div>
            <div class="card-body">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr><th>CV</th><th>Candidate</th><th>Likes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cv in _visibleCvs)
                        {
                            <tr>
                                <td><a href="/cvs/@cv.Id">@cv.Title</a></td>
                                <td>@cv.CandidateProfile?.User?.DisplayName</td>
                                <td>@cv.LikeCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <DiscussionPanel PositionId="_position.Id" />
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private Position? _position;
    private List<CvManagement.Data.Entities.Cv.CvRecord> _visibleCvs = new();
    private bool _isRecruiter;
    private bool _isCandidate;
    private bool _canAccess;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _position = await PositionService.GetByIdAsync(Guid.Parse(Id));
        _isRecruiter = await CurrentUserService.IsInRoleAsync("Recruiter") || await CurrentUserService.IsInRoleAsync("Administrator");
        _isCandidate = await CurrentUserService.IsInRoleAsync("Candidate");

        if (_position is not null)
        {
            if (_isRecruiter)
                _visibleCvs = await CvService.GetVisibleCvsForPositionAsync(_position.Id);
            if (_isCandidate)
            {
                var userId = await CurrentUserService.GetUserIdAsync();
                if (userId is not null)
                {
                    var profile = await ProfileService.GetOrCreateProfileAsync(userId.Value);
                    _canAccess = await PositionService.CanCandidateAccessAsync(profile.Id, _position.Id);
                }
            }
        }
    }

    private async Task Duplicate()
    {
        if (_position is null) return;
        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null) return;
        try
        {
            var copy = await PositionService.DuplicateAsync(_position.Id, userId.Value);
            Navigation.NavigateTo($"/positions/edit/{copy.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }
}
