@using CvManagement.Services.Auth
@inject ICurrentUserService CurrentUser
@rendermode InteractiveServer

<nav class="topbar navbar navbar-expand-lg sticky-top px-3 py-2">
    <div class="container-fluid">
        <button class="btn btn-sm btn-outline-secondary d-lg-none me-2" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#main-sidebar" aria-controls="main-sidebar"
                aria-label="@Loc["Nav.ToggleNavigation"]">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand fw-bold" href="/">@Loc["TopBar.Brand"]</a>

        <div class="d-none d-md-flex flex-grow-1 mx-4" style="max-width: 400px;">
            <SearchBar />
        </div>

        <div class="d-flex align-items-center gap-2">
            <ThemeToggle />
            <LanguageSelector />

            @if (CurrentUser.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                            aria-label="@Loc["TopBar.UserMenu"]">
                        @(_displayName ?? "User")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/profile">@Loc["Nav.MyProfile"]</a></li>
                        <li><a class="dropdown-item" href="/cvs">@Loc["Nav.MyCvs"]</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>

                            <a class="dropdown-item" href="/logout">@Loc["TopBar.SignOut"]</a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/login" class="btn btn-sm btn-primary">@Loc["TopBar.SignIn"]</a>
            }
        </div>
    </div>

    <div class="d-md-none mt-2">
        <SearchBar />
    </div>
</nav>

@code {
    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.IsAuthenticated)
        {
            _displayName = await CurrentUser.GetUserDisplayNameAsync();
        }
    }
}
