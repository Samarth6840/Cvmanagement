@page "/Error"
@using System.Diagnostics

<PageTitle>@Loc["Error.Title"]</PageTitle>

<h1 class="text-danger">@Loc["Error.Short"]</h1>
<h2 class="text-danger">@Loc["Error.Description"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc["Error.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Loc["Error.DevMode"]</h3>
<p>
    @Loc["Error.DevSwap"] <strong>@Loc["Error.DevDisplay"]</strong> @Loc["Error.DevInfo"]
</p>
<p>
    <strong>@Loc["Error.DevWarn"]</strong>
    @Loc["Error.DevSensitive1"]
    @Loc["Error.DevSensitive2"] <strong>@Loc["Error.DevDisplay"]</strong> @Loc["Error.DevSensitive3"] <strong>ASPNETCORE_ENVIRONMENT</strong> @Loc["Error.DevSensitive4"] <strong>@Loc["Error.DevDisplay"]</strong>
    @Loc["Error.DevSensitive5"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
