@page "/access-denied"

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="display-4 text-danger">@Loc["Auth.AccessDenied"]</h1>
            <p class="lead">@Loc["Auth.NoPermission"]</p>
            <a href="/" class="btn btn-primary">@Loc["Auth.GoHome"]</a>
        </div>
    </div>
</div>
