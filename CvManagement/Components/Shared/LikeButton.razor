@using CvManagement.Services.Likes
@using CvManagement.Services.Auth
@using CvManagement.Data.Entities.Identity
@inject ILikeService LikeService
@inject ICurrentUserService CurrentUserService
@rendermode InteractiveServer

@if (_isRecruiter)
{
    <button class="btn btn-sm @(_isLiked ? "btn-danger" : "btn-outline-secondary")"
            @onclick="Toggle"
            disabled="@_busy"
            title="@(_isLiked ? "Remove like" : "Like this CV")">
        @(_isLiked ? "♥" : "♡") @_likeCount
    </button>
}

@code {
    [Parameter] public Guid CvRecordId { get; set; }
    [Parameter] public EventCallback<int> LikeCountChanged { get; set; }

    private bool _isLiked;
    private int _likeCount;
    private bool _isRecruiter;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _isRecruiter = await CurrentUserService.IsInRoleAsync(RoleNames.Recruiter)
            || await CurrentUserService.IsInRoleAsync(RoleNames.Administrator);
        if (!_isRecruiter) return;

        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is not null)
            _isLiked = await LikeService.HasUserLikedAsync(userId.Value, CvRecordId);

        _likeCount = await LikeService.GetLikeCountAsync(CvRecordId);
    }

    private async Task Toggle()
    {
        if (_busy) return;

        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null) return;

        _busy = true;
        try
        {
            _isLiked = await LikeService.ToggleAsync(userId.Value, CvRecordId);
            _likeCount = await LikeService.GetLikeCountAsync(CvRecordId);
            await LikeCountChanged.InvokeAsync(_likeCount);
        }
        finally
        {
            _busy = false;
        }
    }
}
