@page "/attributes"
@using CvManagement.Services.Attributes
@using CvManagement.Data.Entities.Attributes
@attribute [Authorize(Policy = AuthorizationPolicies.RecruiterOnly)]
@inject IAttributeService AttributeService
@inject IJSRuntime Js
@rendermode InteractiveServer

<h3>@Loc["Attribute.LibraryTitle"]</h3>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}

@* Spec §2: actions live in a toolbar and act on the selection — never repeated per row. *@
<div class="table-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <input type="text" class="form-control form-control-sm" style="max-width: 16rem;"
           placeholder="@Loc["Attribute.SearchPlaceholder"]"
           @bind="_searchPrefix" @bind:event="oninput" />

    <select class="form-select form-select-sm w-auto" @bind="_selectedCategory">
        <option value="">@Loc["Position.AllCategories"]</option>
        @foreach (var cat in Enum.GetValues<AttributeCategory>())
        {
            <option value="@cat">@cat</option>
        }
    </select>

    <span class="text-muted small">@Loc["List.Selected", _selectedIds.Count]</span>

    <div class="ms-auto d-flex gap-2">
        <a href="/attributes/edit" class="btn btn-primary btn-sm">@Loc["Attribute.Create"]</a>
        <button class="btn btn-outline-primary btn-sm" disabled="@(_selectedIds.Count != 1)"
                @onclick="EditSelected">@Loc["Common.Edit"]</button>
        <button class="btn btn-outline-danger btn-sm" disabled="@(_selectedIds.Count == 0)"
                @onclick="DeleteSelected">@Loc["Common.Delete"]</button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 2.5rem;">
                    <input type="checkbox" class="form-check-input" aria-label="@Loc["List.SelectAll"]"
                           checked="@_allVisibleSelected" @onchange="ToggleSelectAll" />
                </th>
                <th>@Loc["Common.Name"]</th>
                <th>@Loc["Common.Category"]</th>
                <th>@Loc["Common.DataType"]</th>
                <th>@Loc["Common.Required"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attr in FilteredAttributes)
            {
                var selected = _selectedIds.Contains(attr.Id);
                <tr class="@(selected ? "is-selected" : null)">
                    <td>
                        <input type="checkbox" class="form-check-input"
                               aria-label="@attr.Name"
                               checked="@selected" @onchange="() => ToggleSelection(attr.Id)" />
                    </td>
                    <td>
                        @attr.Name
                        @if (attr.IsBuiltIn)
                        {
                            <span class="badge text-bg-light ms-1">@Loc["Attribute.BuiltIn"]</span>
                        }
                    </td>
                    <td>@attr.Category</td>
                    <td>@attr.DataType</td>
                    <td>@(attr.IsRequired ? Loc["Common.Yes"] : Loc["Common.No"])</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!FilteredAttributes.Any())
{
    <p class="text-muted">@Loc["Attribute.NoAttributes"]</p>
}

@code {
    private List<AttributeDefinition> _allAttributes = [];
    private HashSet<Guid> _selectedIds = [];
    private string _searchPrefix = "";
    private string _selectedCategory = "";
    private string? _error;

    private IEnumerable<AttributeDefinition> FilteredAttributes =>
        _allAttributes
            .Where(a => string.IsNullOrEmpty(_searchPrefix)
                        || a.Name.Contains(_searchPrefix, StringComparison.OrdinalIgnoreCase))
            .Where(a => string.IsNullOrEmpty(_selectedCategory) || a.Category.ToString() == _selectedCategory);

    private bool _allVisibleSelected =>
        FilteredAttributes.Any() && FilteredAttributes.All(a => _selectedIds.Contains(a.Id));

    protected override async Task OnInitializedAsync()
    {
        _allAttributes = await AttributeService.GetAllAsync();
    }

    private void ToggleSelection(Guid id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);

        _error = null;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            _selectedIds.UnionWith(FilteredAttributes.Select(a => a.Id));
        else
            _selectedIds.Clear();
    }

    private void EditSelected()
    {
        var id = _selectedIds.Single();
        Navigation.NavigateTo($"/attributes/edit/{id}");
    }

    private async Task DeleteSelected()
    {
        _error = null;

        var confirmed = await Js.InvokeAsync<bool>(
            "confirm", Loc["List.ConfirmDelete"].Value);
        if (!confirmed)
            return;

        try
        {
            await AttributeService.DeleteManyAsync(_selectedIds.ToList());
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }

        _allAttributes.RemoveAll(a => _selectedIds.Contains(a.Id));
        _selectedIds.Clear();
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
