@page "/register"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using CvManagement.Data.Entities.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@layout AuthLayout

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">@Loc["Auth.CreateAccountTitle"]</h3>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        <form @onsubmit="HandleRegister">
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.DisplayName"]</label>
                <input type="text" class="form-control" @bind="DisplayName" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.Email"]</label>
                <input type="email" class="form-control" @bind="Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.Password"]</label>
                <input type="password" class="form-control" @bind="Password" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc["Auth.ConfirmPassword"]</label>
                <input type="password" class="form-control" @bind="ConfirmPassword" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">@Loc["Auth.Register"]</button>
        </form>

        <div class="text-center mt-3">
            <a href="/login">@Loc["Auth.AlreadyHaveAccount"]</a>
        </div>
    </div>
</div>

@code {
    public string DisplayName { get; set; } = "";
    public string Email { get; set; } = "";
    public string Password { get; set; } = "";
    public string ConfirmPassword { get; set; } = "";

    private string? ErrorMessage;

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(DisplayName) || string.IsNullOrWhiteSpace(Email) ||
            string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            ErrorMessage = Loc["Auth.AllFieldsRequired"];
            return;
        }

        if (Password != ConfirmPassword)
        {
            ErrorMessage = Loc["Auth.PasswordsDoNotMatch"];
            return;
        }

        var user = new ApplicationUser
        {
            UserName = Email,
            Email = Email,
            DisplayName = DisplayName,
            EmailConfirmed = true
        };

        var result = await UserManager.CreateAsync(user, Password);
        if (result.Succeeded)
        {
            await UserManager.AddToRoleAsync(user, RoleNames.Candidate);
            await SignInManager.SignInAsync(user, isPersistent: true);
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
            ErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
