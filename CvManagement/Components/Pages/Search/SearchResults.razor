@page "/search"
@using CvManagement.Services.Search
@using CvManagement.Services.Auth
@using CvManagement.Data.Entities.Identity
@inject ISearchService SearchService
@inject ICurrentUserService CurrentUserService
@rendermode InteractiveServer

<h3>@Loc["Search.Results"]</h3>

@if (!string.IsNullOrEmpty(_query))
{
    <p class="text-muted mb-3">@Loc["Search.ResultsFor", _query]: @_results.Count</p>
}

@if (_loading)
{
    <p>@Loc["Search.Searching"]</p>
}
else if (_results.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Loc["Search.Type"]</th>
                    <th>@Loc["Common.Title"]</th>
                    <th>@Loc["Search.Details"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in _results)
                {
                    <tr>
                        <td><span class="badge @(result.Type == SearchResultType.Position ? "bg-primary" : "bg-success")">@DescribeType(result.Type)</span></td>
                        <td>
                            @if (result.Type == SearchResultType.Position)
                            {
                                <a href="/positions/@result.Id">@result.Title</a>
                            }
                            else
                            {
                                <a href="/cvs/@result.Id">@result.Title</a>
                            }
                        </td>
                        <td class="text-muted small">@result.Subtitle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!string.IsNullOrEmpty(_query))
{
    <p class="text-muted">@Loc["Search.NoResults"]</p>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    private string? Type { get; set; }

    private SearchResultType? RequestedType =>
        string.Equals(Type, "cv", StringComparison.OrdinalIgnoreCase) ? SearchResultType.Cv
        : string.Equals(Type, "position", StringComparison.OrdinalIgnoreCase) ? SearchResultType.Position
        : null;

    private string _query = string.Empty;
    private List<SearchResult> _results = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var isRecruiter = await CurrentUserService.IsInRoleAsync(RoleNames.Recruiter)
            || await CurrentUserService.IsInRoleAsync(RoleNames.Administrator);

        _query = Query ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_query)) return;

        _loading = true;
        var results = await SearchService.SearchAsync(_query, isRecruiter);

        // The tag cloud links a Recruiter at CVs and a candidate at positions (spec §11), so
        // an explicit type from the query string wins over the role default.
        var preferredType = RequestedType
            ?? (isRecruiter ? SearchResultType.Cv : SearchResultType.Position);
        _results = results
            .OrderByDescending(r => r.Type == preferredType)
            .ThenByDescending(r => r.Rank)
            .ToList();
        _loading = false;
    }

    private string DescribeType(SearchResultType type) =>
        type == SearchResultType.Position ? Loc["Search.TypePosition"] : Loc["Search.TypeCv"];
}
