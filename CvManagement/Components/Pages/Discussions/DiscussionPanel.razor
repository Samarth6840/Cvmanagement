@using CvManagement.Services.Discussions
@using CvManagement.Services.Auth
@using CvManagement.Services.Markdown
@using CvManagement.Data.Entities.Discussions
@using Microsoft.AspNetCore.SignalR.Client
@inject IDiscussionService DiscussionService
@inject ICurrentUserService CurrentUserService
@inject IMarkdownRenderer MarkdownRenderer
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Loc["Discussion.Title"]</h5>
        <span class="badge bg-secondary">@Loc["Discussion.MessageCount", _messages.Count]</span>
    </div>
    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
        @if (_messages.Any())
        {
            @foreach (var msg in _messages)
            {
                <div class="mb-3 p-2 rounded border">
                    <div class="d-flex justify-content-between">
                        <strong>
                            @* Spec §10: a Recruiter sees the author name as a link to the public profile. *@
                            @if (_isRecruiter)
                            {
                                <a href="/users/@msg.UserId">@msg.User?.DisplayName</a>
                            }
                            else
                            {
                                @msg.User?.DisplayName
                            }
                        </strong>
                        <small class="text-muted">@msg.CreatedAt.ToString("MMM dd, HH:mm")</small>
                    </div>
                    <MarkdownPreview Markdown="@msg.Content" />
                </div>
            }
        }
        else
        {
            <p class="text-muted">@Loc["Discussion.NoMessages"]</p>
        }
    </div>
    <div class="card-footer">
        @if (_isAuthenticated)
        {
            <MarkdownEditor Value="@_newMessage" ValueChanged="OnMessageChanged"
                            Placeholder="@Loc["Discussion.Placeholder"]" Rows="3" />
            <div class="d-flex justify-content-end">
                <button class="btn btn-primary" @onclick="Send"
                        disabled="@(string.IsNullOrWhiteSpace(_newMessage) || !_connected)">
                    @Loc["Discussion.Send"]
                </button>
            </div>
        }
        else
        {
            @* Spec §3.2: anonymous visitors browse read-only. *@
            <p class="text-muted mb-0">
                <a href="/login">@Loc["TopBar.SignIn"]</a> @Loc["Discussion.SignInToPost"]
            </p>
        }
    </div>
</div>

@code {
    [Parameter] public Guid PositionId { get; set; }

    private List<DiscussionMessage> _messages = [];
    private HubConnection? _hubConnection;
    private string _newMessage = "";
    private bool _connected;
    private bool _isRecruiter;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = CurrentUserService.IsAuthenticated;
        _isRecruiter = await CurrentUserService.IsInRoleAsync(RoleNames.Recruiter)
            || await CurrentUserService.IsInRoleAsync(RoleNames.Administrator);
        _messages = await DiscussionService.GetMessagesAsync(PositionId);

        // The hub requires authentication, so an anonymous reader never connects: doing so
        // would only fault the connection.
        if (!_isAuthenticated)
            return;

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/discussion"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<DiscussionMessage>("ReceiveMessage", message =>
        {
            _messages.Add(message);
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
        await _hubConnection.InvokeAsync("JoinGroup", PositionId);
        _connected = true;
    }

    private void OnMessageChanged(string value) => _newMessage = value;

    private async Task Send()
    {
        if (_hubConnection is null || string.IsNullOrWhiteSpace(_newMessage))
            return;

        await _hubConnection.InvokeAsync("SendMessage", PositionId, _newMessage);
        _newMessage = "";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
