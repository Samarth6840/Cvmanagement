@inherits LayoutComponentBase

<div class="auth-layout">
    <header class="auth-layout-header">
        <a class="auth-layout-brand" href="/">@Loc["TopBar.Brand"]</a>
        <div class="auth-layout-search">
            <SearchBar />
        </div>
    </header>

    <div class="auth-layout-inner">
        @Body
    </div>
</div>

<style>
    .auth-layout {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .auth-layout-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0.75rem 1rem;
    }

    .auth-layout-brand {
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        font-size: 1.1rem;
    }

    .auth-layout-search {
        flex: 1 1 16rem;
        max-width: 24rem;
    }

    .auth-layout-inner {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 420px;
        margin: 0 auto;
        padding: 1rem;
    }
</style>
