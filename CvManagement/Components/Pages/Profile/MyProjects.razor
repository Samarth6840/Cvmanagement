@page "/my/projects"
@using CvManagement.Services.Projects
@using CvManagement.Services.Auth
@using CvManagement.Services.Profiles
@using CvManagement.Data.Entities.Projects
@attribute [Authorize]
@inject IProjectService ProjectService
@inject ICurrentUserService CurrentUserService
@inject IProfileService ProfileService
@inject IJSRuntime Js
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>@Loc["Project.ListTitle"]</h3>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}

<div class="table-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="text-muted small">@Loc["List.Selected", _selectedIds.Count]</span>

    <div class="ms-auto d-flex gap-2">
        <a href="/my/projects/edit" class="btn btn-primary btn-sm">@Loc["Project.Create"]</a>
        <button class="btn btn-outline-primary btn-sm" disabled="@(_selectedIds.Count != 1)"
                @onclick="EditSelected">@Loc["Common.Edit"]</button>
        <button class="btn btn-outline-danger btn-sm" disabled="@(_selectedIds.Count == 0)"
                @onclick="DeleteSelected">@Loc["Common.Delete"]</button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th style="width: 2.5rem;">
                    <input type="checkbox" class="form-check-input" aria-label="@Loc["List.SelectAll"]"
                           checked="@_allSelected" @onchange="ToggleSelectAll" />
                </th>
                <th>@Loc["Common.Name"]</th>
                <th>@Loc["Project.Tags"]</th>
                <th>@Loc["Project.Period"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in _projects)
            {
                var selected = _selectedIds.Contains(project.Id);
                <tr class="@(selected ? "is-selected" : null)">
                    <td>
                        <input type="checkbox" class="form-check-input" aria-label="@project.Name"
                               checked="@selected" @onchange="() => ToggleSelection(project.Id)" />
                    </td>
                    <td>@project.Name</td>
                    <td>
                        @foreach (var tag in project.Tags.Take(4))
                        {
                            <span class="badge bg-secondary me-1">@tag.Tag</span>
                        }
                    </td>
                    <td>
                        @project.StartDate?.ToString("MMM yyyy") - @(project.EndDate?.ToString("MMM yyyy") ?? Loc["Common.Present"].Value)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!_projects.Any())
{
    <p class="text-muted">@Loc["Project.NoProjects"]</p>
}

@code {
    private List<Project> _projects = [];
    private HashSet<Guid> _selectedIds = [];
    private Guid? _profileId;
    private string? _error;

    private bool _allSelected =>
        _projects.Any() && _projects.All(p => _selectedIds.Contains(p.Id));

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUserService.GetUserIdAsync();
        if (userId is null)
            return;

        var profile = await ProfileService.GetOrCreateProfileAsync(userId.Value);
        _profileId = profile.Id;
        _projects = await ProjectService.GetForCandidateAsync(profile.Id);
    }

    private void ToggleSelection(Guid id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);

        _error = null;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            _selectedIds.UnionWith(_projects.Select(p => p.Id));
        else
            _selectedIds.Clear();
    }

    private void EditSelected() =>
        Navigation.NavigateTo($"/my/projects/edit/{_selectedIds.Single()}");

    private async Task DeleteSelected()
    {
        if (_profileId is null)
            return;

        _error = null;

        var confirmed = await Js.InvokeAsync<bool>("confirm", Loc["List.ConfirmDeleteProject"].Value);
        if (!confirmed)
            return;

        await ProjectService.DeleteManyForCandidateAsync(_profileId.Value, _selectedIds.ToList());

        _projects.RemoveAll(p => _selectedIds.Contains(p.Id));
        _selectedIds.Clear();
    }
}
