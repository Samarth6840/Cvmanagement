@page "/attributes/edit/{Id?}"
@using CvManagement.Services.Attributes
@using CvManagement.Services.Concurrency
@using CvManagement.Data.Entities.Attributes
@attribute [Authorize(Policy = AuthorizationPolicies.RecruiterOnly)]
@inject IAttributeService AttributeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>@(_isNew ? Loc["Attribute.CreateTitle"] : Loc["Attribute.EditTitle"])</h3>

@if (_attribute is not null)
{
    @if (_error is not null)
    {
        <div class="alert alert-warning">@_error <button class="btn btn-sm btn-warning ms-2" @onclick="Reload">@Loc["Common.Reload"]</button></div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Loc["Common.Name"]</label>
                    <input type="text" class="form-control" @bind="_attribute.Name" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">@Loc["Common.Category"]</label>
                    <select class="form-select" @bind="_attribute.CategoryId">
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">@Loc["Common.DataType"]</label>
                    <select class="form-select" @bind="_attribute.DataType">
                        @foreach (var dt in Enum.GetValues<AttributeDataType>())
                        {
                            <option value="@dt">@dt</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">@Loc["Common.Description"]</label>
                <textarea class="form-control" rows="2" @bind="_attribute.Description"></textarea>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" @bind="_attribute.IsRequired" />
                    <label class="form-check-label">@Loc["Attribute.RequiredForPublishing"]</label>
                </div>
            </div>

            @if (_attribute.DataType == AttributeDataType.OneOfMany)
            {
                <hr />
                <h5>@Loc["Attribute.Options"]</h5>
                <div class="d-flex gap-2 mb-2">
                    <input type="text" class="form-control form-control-sm" placeholder="@Loc["Attribute.NewOptionPlaceholder"]" @bind="_newOptionLabel" />
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddOption">@Loc["Attribute.AddOption"]</button>
                </div>
                @foreach (var opt in _options)
                {
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span>@opt.Label</span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveOption(opt)">@Loc["Attribute.Remove"]</button>
                    </div>
                }
            }

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="Save">@Loc["Common.Save"]</button>
                <a href="/attributes" class="btn btn-secondary">@Loc["Common.Cancel"]</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    private AttributeDefinition? _attribute;
    private List<AttributeOption> _options = new();
    private List<AttributeCategory> _categories = new();
    private bool _isNew;
    private string _newOptionLabel = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _categories = await AttributeService.GetCategoriesAsync();

        if (string.IsNullOrEmpty(Id) || Id == "new")
        {
            _isNew = true;
            _attribute = new AttributeDefinition { CategoryId = _categories.FirstOrDefault()?.Id ?? 0 };
        }
        else
        {
            _attribute = await AttributeService.GetByIdAsync(Guid.Parse(Id));
            if (_attribute is not null)
                _options = await AttributeService.GetOptionsAsync(_attribute.Id);
        }
    }

    private async Task Save()
    {
        if (_attribute is null) return;

        try
        {
            if (_isNew)
                await AttributeService.CreateAsync(_attribute);
            else
                await AttributeService.UpdateAsync(_attribute.Id, _attribute, _attribute.RowVersion);

            Navigation.NavigateTo("/attributes");
        }
        catch (ConcurrencyConflictException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Reload()
    {
        if (_attribute is null) return;
        _attribute = await AttributeService.GetByIdAsync(_attribute.Id);
        _options = _attribute is null ? [] : await AttributeService.GetOptionsAsync(_attribute.Id);
        _error = null;
    }

    private async Task AddOption()
    {
        if (_attribute is null || string.IsNullOrWhiteSpace(_newOptionLabel)) return;
        var opt = await AttributeService.AddOptionAsync(_attribute.Id, _newOptionLabel);
        _options.Add(opt);
        _newOptionLabel = "";
    }

    private async Task RemoveOption(AttributeOption opt)
    {
        if (_attribute is null) return;
        await AttributeService.RemoveOptionAsync(_attribute.Id, opt.Id);
        _options.Remove(opt);
    }
}
