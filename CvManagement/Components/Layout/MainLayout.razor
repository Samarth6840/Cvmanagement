@inherits LayoutComponentBase
@using CvManagement.Services.Auth
@inject ICurrentUserService CurrentUser

<div class="page">
    <TopBar />

    <div class="d-flex">

        <div class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="main-sidebar"
             aria-labelledby="main-sidebar-label">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="main-sidebar-label">@Loc["Nav.Menu"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#main-sidebar"
                        aria-label="@Loc["Common.Close"]"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-3">
                <NavMenu />
            </div>
        </div>

        <main class="flex-grow-1 p-3 p-md-4" style="min-height: calc(100vh - 56px);">
            <div class="container-fluid">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    @Loc["Error.Description"]
    <a href="" class="reload">@Loc["Common.Reload"]</a>
    <a class="dismiss">X</a>
</div>
